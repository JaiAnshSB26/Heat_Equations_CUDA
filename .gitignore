# Step 1 – sequential solver (just avoiding the executables)
heat2d
heat2d.exe

# Generated simulation data
# Snapshot .dat files and rendered images are large and reproducible, hene we don't
# commit them. They can be regenerated by running the solver + gnuplot.
*/snapshots/

**/snapshots/
*.dat
*.gif
*.png

